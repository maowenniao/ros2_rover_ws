<?xml version="1.0" ?>
<!--
  rover.urdf.xacro
  四轴差速无人小车的简化 3D 模型

  参数（可在 launch 中覆盖）：
    wheel_radius  - 轮子半径 (m)
    wheel_width   - 轮子宽度 (m)
    body_length   - 车体长度 (m)
    body_width    - 车体宽度 (m)
    body_height   - 车体高度 (m)
    track_width   - 左右轮距 (m)
    wheel_base    - 前后轴距 (m)
    body_mass     - 车体质量 (kg)
    wheel_mass    - 轮子质量 (kg)
-->
<robot name="rover" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="wheel_radius" default="0.15" />
  <xacro:property name="wheel_width"  default="0.08" />
  <xacro:property name="body_length"  default="0.60" />
  <xacro:property name="body_width"   default="0.55" />
  <xacro:property name="body_height"  default="0.25" />
  <xacro:property name="track_width"  default="0.55" />
  <xacro:property name="wheel_base"   default="0.60" />
  <xacro:property name="body_mass"    default="15.0" />
  <xacro:property name="wheel_mass"   default="1.0" />

  <!-- ============== 车体基座（base_link） ============== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="${body_mass}" />
      <inertia ixx="${(body_mass/12.0)*(body_width*body_width + body_height*body_height)}"
               iyy="${(body_mass/12.0)*(body_length*body_length + body_height*body_height)}"
               izz="${(body_mass/12.0)*(body_length*body_length + body_width*body_width)}"
               ixy="0" ixz="0" iyz="0" />
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}" />
      </geometry>
      <material name="chassis">
        <color rgba="0.2 0.4 0.8 1.0" />
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}" />
      </geometry>
    </collision>
  </link>

  <!-- ============== 传感器支架（朝前） ============== -->
  <link name="sensor_mount">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.10 0.05" />
      </geometry>
      <material name="sensor_mat">
        <color rgba="0.8 0.8 0.2 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.10 0.05" />
      </geometry>
    </collision>
  </link>

  <joint name="sensor_mount_joint" type="fixed">
    <parent link="base_link" />
    <child link="sensor_mount" />
    <origin xyz="${body_length/2 - 0.05} 0 ${body_height/2 + 0.025}" rpy="0 0 0" />
  </joint>

  <!-- ============== D435i 相机模型 ============== -->
  <link name="d435i_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.072" />
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.090 0.025" />
      </geometry>
      <material name="d435i_mat">
        <color rgba="0.1 0.1 0.1 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.090 0.025" />
      </geometry>
    </collision>
  </link>

  <joint name="d435i_joint" type="fixed">
    <parent link="sensor_mount" />
    <child link="d435i_link" />
    <origin xyz="0.025 0 0.02" rpy="0 0 0" />
  </joint>

  <!-- ============== 4 个轮子宏 ============== -->
  <xacro:macro name="wheel_link" params="prefix x y">
    <link name="${prefix}_wheel">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="${wheel_mass}" />
        <inertia ixx="${0.5*wheel_mass*wheel_radius*wheel_radius}"
                 iyy="${0.5*wheel_mass*wheel_radius*wheel_radius}"
                 izz="${0.5*wheel_mass*wheel_radius*wheel_radius}"
                 ixy="0" ixz="0" iyz="0" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="wheel_mat">
          <color rgba="0.1 0.1 0.1 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel" />
      <origin xyz="${x} ${y} ${-body_height/2 + wheel_radius}" rpy="0 0 0" />
      <axis xyz="0 1 0" />
    </joint>
  </xacro:macro>

  <!-- 调用宏：4 个轮子（左前、左后、右前、右后）-->
  <xacro:wheel_link prefix="lf" x="${wheel_base/2}"  y="${track_width/2}" />
  <xacro:wheel_link prefix="lr" x="${-wheel_base/2}" y="${track_width/2}" />
  <xacro:wheel_link prefix="rf" x="${wheel_base/2}"  y="${-track_width/2}" />
  <xacro:wheel_link prefix="rr" x="${-wheel_base/2}" y="${-track_width/2}" />

  <!-- ============== Gazebo 颜色插件（如使用 Gazebo 仿真，可启用）============== -->
  <!-- <gazebo>
    <plugin name="rover_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <left_joint>lr_wheel_joint</left_joint>
      <right_joint>rr_wheel_joint</right_joint>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_diameter>${2*wheel_radius}</wheel_diameter>
      <command_topic>/cmd_vel</command_topic>
      <odometry_topic>/wheel_odom</odometry_topic>
    </plugin>
  </gazebo> -->

</robot>